PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=warehouse_receiving_db
DATABASE_URL=postgresql://postgres:@localhost:5432/warehouse_receiving_db

# Security & Tokens
